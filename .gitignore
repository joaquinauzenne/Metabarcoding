# Ignore fastq and sequencing files
*.fastq
*.fastq.gz
*.fq
*.fq.gz

# Ignore BAM/SAM alignment files
*.bam
*.sam

# Ignore intermediate results
*.sif
*.tar.gz
*.zip
*.log
*.aux
*.out

# Ignore hidden system files (especially from MacOS or Windows)
.DS_Store
Thumbs.db
desktop.ini

# Ignore temp files
*.tmp
*.temp
*.swp

# Ignore Python/R data
*.rds
*.RData
*.h5
*.hdf5
*.pkl

# Ignore Conda or virtual environments
.env/
.venv/
__pycache__/
*.pyc

# Ignore result folders if you have them
.Rproj.user/
.Rhistory

# Generated eDNA data and pipeline outputs
eDNA/

# BLAST databases (large, downloaded separately)
blastdb/
scripts/mammalia_nt_db/
scripts/taxonomy4blast.sqlite3

# Temporary / editor files
tempCodeRunnerFile.*
*.code-workspace

# Internal Claude Code session context (local only)
CLAUDE.md

# Golem / Shiny app
edna-viz/.Rcheck/

# DADA2 intermediates
scripts/dada2_output/
