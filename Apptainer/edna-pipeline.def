Bootstrap: docker
From: ubuntu:20.04

%labels
    Author    JoaquinAuzenne
    Version   1.1

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y \
        wget bzip2 ca-certificates curl procps && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

    # Install Miniforge3 — provides mamba + conda-forge defaults.
    # No tarball copy needed; everything installs from public channels.
    wget -q \
        https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh \
        -O /tmp/miniforge.sh
    bash /tmp/miniforge.sh -b -p /opt/conda
    rm /tmp/miniforge.sh

    # Create the edna-pipeline environment.
    # Includes all tools that were in the original pack PLUS the four that were missing:
    #   seqtk, vsearch, r-base (+r-tidyverse), krona (ktImportText).
    /opt/conda/bin/mamba create -y -n edna-pipeline \
        -c conda-forge -c bioconda \
        python=3.10 \
        cutadapt \
        fastqc \
        nanoplot \
        multiqc \
        blast \
        ngspeciesid \
        mafft \
        cd-hit \
        seqtk \
        vsearch \
        krona \
        perl \
        perl-bioperl \
        r-base \
        r-tidyverse \
        r-dplyr \
        r-ggplot2

    # Initialise Krona taxonomy database.
    # Runs during build so ktImportText works without network on Lonestar6.
    /opt/conda/envs/edna-pipeline/opt/krona/updateTaxonomy.sh 2>/dev/null || true

    # Shrink image — remove installer cache.
    /opt/conda/bin/conda clean -afy

%environment
    # Expose the environment's bin directly — no conda activation needed.
    # Tools are accessible as plain executables once PATH is set.
    export PATH=/opt/conda/envs/edna-pipeline/bin:/opt/conda/bin:$PATH
    export CONDA_DEFAULT_ENV=edna-pipeline

%runscript
    exec "$@"
