Bootstrap: docker
From: condaforge/miniforge3:latest

%labels
    Author    JoaquinAuzenne
    Version   1.2

%post
    # condaforge/miniforge3 base already provides mamba, conda, wget, curl.
    # No apt-get or Miniforge download needed — avoids HPC outbound HTTP restrictions.

    # Create the edna-pipeline environment with all pipeline tools.
    # Adds the four that were missing from the original pack:
    #   seqtk, vsearch, r-base (+r-tidyverse), krona (ktImportText).
    mamba create -y -n edna-pipeline \
        -c conda-forge -c bioconda \
        python=3.10 \
        cutadapt \
        fastqc \
        nanoplot \
        multiqc \
        blast \
        ngspeciesid \
        mafft \
        cd-hit \
        seqtk \
        vsearch \
        krona \
        perl \
        perl-bioperl \
        r-base \
        r-tidyverse \
        r-dplyr \
        r-ggplot2

    # Initialise Krona taxonomy database.
    /opt/conda/envs/edna-pipeline/opt/krona/updateTaxonomy.sh 2>/dev/null || true

    # Remove installer cache to reduce image size.
    mamba clean -afy

%environment
    # Expose the environment's bin directly — no conda activation needed.
    export PATH=/opt/conda/envs/edna-pipeline/bin:/opt/conda/bin:$PATH
    export CONDA_DEFAULT_ENV=edna-pipeline

%runscript
    exec "$@"
